{
  "name": "phoneagent-host-controller",
  "version": "0.2.0",
  "description": "macOS controller shell for the PhoneAgent tailnet gateway",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac dmg --publish=never",
    "package:mac-dir": "electron-builder --mac dir --publish=never",
    "lint:static": "node --check electron/main.js && node --check electron/preload.js && node --check renderer/app.js"
  },
  "build": {
    "appId": "dev.phoneagent.hostcontroller",
    "productName": "PhoneAgent Host Controller",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "renderer/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "darkModeSupport": true
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.6.4"
  }
}
